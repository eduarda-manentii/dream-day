<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="342.0" prefWidth="421.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.VincularItemWindowController">
   <children>
      <Label layoutX="25.0" layoutY="38.0" text="Vincular Item ao Orçamento">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="lblItem" layoutX="39.0" layoutY="93.0" text="Item" />
      <ComboBox fx:id="cbItem" layoutX="83.0" layoutY="88.0" prefHeight="28.0" prefWidth="307.0" />
      <Label fx:id="lblDataDeEntrega" layoutX="39.0" layoutY="187.0" text="Data de entrega" />
      <TextField fx:id="txtDadaDeEntrega" layoutX="150.0" layoutY="182.0" prefHeight="28.0" prefWidth="236.0" />
      <Label fx:id="lblStatus" layoutX="39.0" layoutY="234.0" text="Status" />
      <ComboBox fx:id="cbStatus" layoutX="89.0" layoutY="230.0" prefHeight="28.0" prefWidth="307.0" />
      <Button fx:id="btnConfirmar" layoutX="222.0" layoutY="287.0" mnemonicParsing="false" onAction="#onButtonConfirmarClicked" prefHeight="28.0" prefWidth="174.0" text="Confirmar" />
      <Button fx:id="btnCancelar" layoutX="39.0" layoutY="287.0" mnemonicParsing="false" onAction="#onButtonCancelarClicked" prefHeight="28.0" prefWidth="174.0" text="Cancelar" />
      <Label fx:id="lblQuantidade" layoutX="40.0" layoutY="140.0" text="Quantidade" />
      <TextField fx:id="txtQuantidade" layoutX="125.0" layoutY="135.0" prefHeight="28.0" prefWidth="266.0" />
   </children>
</AnchorPane>

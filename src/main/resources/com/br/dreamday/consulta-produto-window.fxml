<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="428.0" prefWidth="690.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.ConsultaProdutoWindowController">
   <children>
      <Label fx:id="lblNome" layoutX="26.0" layoutY="101.0" text="Nome" />
      <TextField fx:id="txtNomeFiltro" layoutX="26.0" layoutY="118.0" prefHeight="25.0" prefWidth="465.0" />
      <Button fx:id="btnAdicionar" layoutX="544.0" layoutY="67.0" mnemonicParsing="false" onAction="#adicionar" prefHeight="25.0" prefWidth="119.0" text="Adicionar" />
      <Button fx:id="btnFiltrar" layoutX="544.0" layoutY="118.0" mnemonicParsing="false" onAction="#filtrar" prefHeight="25.0" prefWidth="119.0" text="Filtrar" />
      <TableView fx:id="tableProduto" layoutX="26.0" layoutY="164.0" prefHeight="200.0" prefWidth="637.0">
         <columns>
            <TableColumn fx:id="codigoColumn" prefWidth="87.0" text="Código" />
            <TableColumn fx:id="nomeColumn" prefWidth="530.0" text="Nome" />
         </columns>
      </TableView>
      <MenuBar prefHeight="33.0" prefWidth="690.0">
         <menus>
            <Menu mnemonicParsing="false" text="Cadastros">
               <items>
                  <MenuItem fx:id="menuItemCadastroCategoria" mnemonicParsing="false" onAction="#mostrarCadastroCategoria" text="Categoria" />
                  <MenuItem fx:id="menuItemCadastroProduto" mnemonicParsing="false" onAction="#mostrarCadastroProduto" text="Produto" />
                  <MenuItem fx:id="menuItemCadastroFornecedor" mnemonicParsing="false" onAction="#mostrarCadastroProduto" text="Fornecedor" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Orçamentos" />
            <Menu mnemonicParsing="false" text="Relatorios" />
         </menus>
      </MenuBar>
      <Button fx:id="btnFiltrar1" layoutX="409.0" layoutY="387.0" mnemonicParsing="false" onAction="#excluir" prefHeight="25.0" prefWidth="119.0" text="Excluir" />
      <Button fx:id="btnEditar" layoutX="544.0" layoutY="387.0" mnemonicParsing="false" onAction="#editar" prefHeight="25.0" prefWidth="119.0" text="Editar" />
   </children>
</AnchorPane>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="386.0" prefWidth="688.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.ConsultaCategoriaWindowController">
   <children>
      <Label fx:id="lblNome" layoutX="21.0" layoutY="79.0" text="Nome" />
      <TextField fx:id="txtNomeFiltro" layoutX="60.0" layoutY="75.0" prefHeight="25.0" prefWidth="459.0" />
      <Button fx:id="btnAdicionar" layoutX="535.0" layoutY="24.0" mnemonicParsing="false" onAction="#adicionar" prefHeight="25.0" prefWidth="119.0" text="Adicionar" />
      <Button fx:id="btnFiltrar" layoutX="535.0" layoutY="75.0" mnemonicParsing="false" onAction="#filtrar" prefHeight="25.0" prefWidth="119.0" text="Filtrar" />
      <TableView fx:id="tableCategoria" layoutX="37.0" layoutY="126.0" prefHeight="200.0" prefWidth="618.0">

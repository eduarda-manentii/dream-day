<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="300.0" prefWidth="435.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.VincularItemWindow">
   <children>
      <Label layoutX="30.0" layoutY="38.0" text="Vincular Item ao Orçamento">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="lblItem" layoutX="44.0" layoutY="93.0" text="Item" />
      <ComboBox fx:id="cbItem" layoutX="88.0" layoutY="88.0" prefHeight="28.0" prefWidth="307.0" />
      <Label fx:id="lblDataDeEntrega" layoutX="44.0" layoutY="143.0" text="Data de entrega" />
      <TextField fx:id="txtDadaDeEntrega" layoutX="155.0" layoutY="138.0" prefHeight="28.0" prefWidth="236.0" />
      <Label fx:id="lblStatus" layoutX="44.0" layoutY="190.0" text="Status" />
      <ComboBox fx:id="cbStatus" layoutX="94.0" layoutY="186.0" prefHeight="28.0" prefWidth="307.0" />
      <Button fx:id="btnConfirmar" layoutX="227.0" layoutY="245.0" mnemonicParsing="false" onAction="#onButtonConfirmarClicked" prefHeight="28.0" prefWidth="174.0" text="Confirmar" />
      <Button fx:id="btnCancelar" layoutX="44.0" layoutY="245.0" mnemonicParsing="false" onAction="#onButtonCancelarClicked" prefHeight="28.0" prefWidth="174.0" text="Cancelar" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="385.0" prefWidth="690.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.ConsultaProdutoWindowController">
   <children>
      <Label fx:id="lblNome" layoutX="27.0" layoutY="48.0" text="Nome" />
      <TextField fx:id="txtNomeFiltro" layoutX="27.0" layoutY="65.0" prefHeight="25.0" prefWidth="465.0" />
      <Button fx:id="btnAdicionar" layoutX="545.0" layoutY="14.0" mnemonicParsing="false" onAction="#adicionar" prefHeight="25.0" prefWidth="119.0" text="Adicionar" />
      <Button fx:id="btnFiltrar" layoutX="545.0" layoutY="65.0" mnemonicParsing="false" onAction="#filtrar" prefHeight="25.0" prefWidth="119.0" text="Filtrar" />
      <TableView fx:id="tableProduto" layoutX="27.0" layoutY="111.0" prefHeight="222.0" prefWidth="637.0">
         <columns>
            <TableColumn fx:id="codigoColumn" prefWidth="87.0" text="Código" />
            <TableColumn fx:id="nomeColumn" prefWidth="530.0" text="Nome" />
         </columns>
      </TableView>
      <Button fx:id="btnFiltrar1" layoutX="411.0" layoutY="347.0" mnemonicParsing="false" onAction="#excluir" prefHeight="25.0" prefWidth="119.0" text="Excluir" />
      <Button fx:id="btnEditar" layoutX="545.0" layoutY="347.0" mnemonicParsing="false" onAction="#editar" prefHeight="25.0" prefWidth="119.0" text="Editar" />
   </children>
</AnchorPane>

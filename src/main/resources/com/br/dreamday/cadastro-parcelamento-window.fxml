<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.CadastroParcelamentoController">
   <children>
      <Label fx:id="lblNovoOrcamento" layoutX="36.0" layoutY="33.0" text="Novo parcelamento">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button fx:id="btnSalvar" layoutX="392.0" layoutY="361.0" mnemonicParsing="false" onAction="#onButtonSalvarClicked" prefHeight="25.0" prefWidth="172.0" text="Salvar" />
      <Button fx:id="btnCancelar" layoutX="210.0" layoutY="361.0" mnemonicParsing="false" onAction="#onButtonCancelarClicked" prefHeight="25.0" prefWidth="179.0" text="Cancelar" />
      <Label layoutX="36.0" layoutY="110.0" prefHeight="17.0" prefWidth="105.0" text="Data vencimento" />
      <Label layoutX="31.0" layoutY="293.0" prefHeight="17.0" prefWidth="85.0" text="Valor total" />
      <Label fx:id="lblValorTotalResultado" layoutX="169.0" layoutY="293.0" prefHeight="17.0" prefWidth="210.0" />
      <TextField fx:id="txtDataVencimento" layoutX="138.0" layoutY="106.0" prefHeight="25.0" prefWidth="439.0" />
      <Label layoutX="36.0" layoutY="177.0" prefHeight="17.0" prefWidth="105.0" text="Observação" />
      <TextArea fx:id="txtObservacao" layoutX="31.0" layoutY="194.0" prefHeight="87.0" prefWidth="538.0" />
      <Label layoutX="36.0" layoutY="142.0" prefHeight="17.0" prefWidth="105.0" text="Qtde de parcelas" />
      <TextField fx:id="txtQtdeParcelas" layoutX="138.0" layoutY="138.0" onAction="#onQtdeParcelasChanged" prefHeight="25.0" prefWidth="439.0" />
      <Label layoutX="31.0" layoutY="322.0" prefHeight="17.0" prefWidth="124.0" text="Valor das parcelas" />
      <Label fx:id="lblValorParcelas" layoutX="169.0" layoutY="322.0" prefHeight="17.0" prefWidth="210.0" />
   </children>
</AnchorPane>

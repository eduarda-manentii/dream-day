<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="478.0" prefWidth="677.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.ClienteRelatorioController">
   <children>
      <Label layoutX="41.0" layoutY="36.0" text="Geração de Relatório por Cliente">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <Label layoutX="41.0" layoutY="88.0" text="Nome do cliente" />
      <ComboBox fx:id="cbCliente" layoutX="41.0" layoutY="115.0" prefHeight="25.0" prefWidth="494.0" promptText="Cliente" />
      <Button fx:id="btnFiltrar" layoutX="547.0" layoutY="115.0" mnemonicParsing="false" onAction="#aoClicarFiltrar" prefHeight="25.0" prefWidth="102.0" text="Filtrar" />
      <Pane fx:id="painelRelatorio" layoutX="41.0" layoutY="172.0" prefHeight="257.0" prefWidth="608.0" style="-fx-border-color: #dbdbdb;" visible="false">
         <children>
            <Label layoutX="14.0" layoutY="14.0" text="Relatório">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblNomeCliente" layoutX="15.0" layoutY="41.0" prefHeight="17.0" prefWidth="141.0" />
            <Label fx:id="lblCusto" layoutX="421.0" layoutY="41.0" prefHeight="17.0" prefWidth="141.0" />
            <Label layoutX="384.0" layoutY="41.0" text="Custo:" />
            <TableView fx:id="table" layoutX="8.0" layoutY="82.0" prefHeight="151.0" prefWidth="592.0">
               <columns>
                  <TableColumn fx:id="itensColumn" prefWidth="195.0" text="Itens" />
                  <TableColumn fx:id="valorColumn" prefWidth="123.0" text="Valor" />
                  <TableColumn fx:id="qtdeColumn" prefWidth="69.0" text="Qtde" />
                  <TableColumn fx:id="totalUnitarioColumn" prefWidth="204.0" text="Total" />
               </columns>
            </TableView>
         </children>
      </Pane>
      <Button fx:id="btnVoltar" layoutX="560.0" layoutY="442.0" mnemonicParsing="false" onAction="#aoClicarVoltar" prefHeight="25.0" prefWidth="89.0" text="Voltar" />
   </children>
</AnchorPane>

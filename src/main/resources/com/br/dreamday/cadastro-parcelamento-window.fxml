<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="280.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.dreamday.controller.CadastroParcelamentoController">
   <children>
      <Label fx:id="lblNovoOrcamento" layoutX="33.0" layoutY="24.0" text="Novo parcelamento">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button fx:id="btnSalvar" layoutX="403.0" layoutY="228.0" mnemonicParsing="false" onAction="#aoClicarSalvar" prefHeight="25.0" prefWidth="172.0" text="Salvar" />
      <Button fx:id="btnCancelar" layoutX="209.0" layoutY="228.0" mnemonicParsing="false" onAction="#aoClicarCancelar" prefHeight="25.0" prefWidth="179.0" text="Cancelar" />
      <Label layoutX="34.0" layoutY="79.0" prefHeight="17.0" prefWidth="105.0" text="Data vencimento" />
      <Label layoutX="34.0" layoutY="152.0" prefHeight="17.0" prefWidth="85.0" text="Valor total" />
      <Label fx:id="lblValorTotalResultado" layoutX="139.0" layoutY="152.0" prefHeight="17.0" prefWidth="210.0" />
      <TextField fx:id="txtDataVencimento" layoutX="136.0" layoutY="75.0" prefHeight="25.0" prefWidth="439.0" />
      <Label layoutX="34.0" layoutY="111.0" prefHeight="17.0" prefWidth="105.0" text="Qtde de parcelas" />
      <TextField fx:id="txtQtdeParcelas" layoutX="136.0" layoutY="107.0" onAction="#aoAlterarQtdeParcelas" prefHeight="25.0" prefWidth="439.0" />
      <Label layoutX="34.0" layoutY="183.0" prefHeight="17.0" prefWidth="124.0" text="Valor das parcelas" />
      <Label fx:id="lblValorParcelas" layoutX="138.0" layoutY="183.0" prefHeight="17.0" prefWidth="210.0" />
   </children>
</AnchorPane>
